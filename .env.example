# MongoDB connection string.
# Local:  mongodb://localhost:27017/ecoloop
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/ecoloop
MONGODB_URI=mongodb://localhost:27017/ecoloop

# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# --- Phase 2/3 (AI semantic matching + photo tagging) ---
# Anthropic API key. Leave unset to use the built-in mock implementations
# (see src/lib/ai.ts once Phase 2/3 land) so the app still runs end-to-end.
ANTHROPIC_API_KEY=
